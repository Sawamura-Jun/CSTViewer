<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.3</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 常駐先への転送をWPFの初期化より前に実行する。 -->
    <StartupObject>CSTViewer.Program</StartupObject>
    <!-- exeに埋め込むアイコンは、複数サイズと透過情報を持つICO形式で指定する。 -->
    <ApplicationIcon>Assets\CSTViewer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.7" />
    <PackageReference Include="OpenCvSharp4.Windows.Slim" Version="4.13.0.20260627" />
  </ItemGroup>

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <TesseractBundleDir Condition="'$(TesseractBundleDir)' == ''">$(MSBuildProjectDirectory)\..\resources\Tesseract-OCR</TesseractBundleDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(TesseractBundleDir)\**\*" Link="Tesseract-OCR\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- OCRに必要な配布ファイルがそろっていることを発行時に確認する。 -->
  <Target Name="ValidateTesseractBundle" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <RequiredTesseractFile Include="$(TesseractBundleDir)\tesseract.exe;$(TesseractBundleDir)\libleptonica-6.dll" />
      <TesseractEngineDll Include="$(TesseractBundleDir)\libtesseract-5*.dll" />
      <RequiredTesseractFile Include="$(TesseractBundleDir)\tessdata\eng.traineddata;$(TesseractBundleDir)\tessdata\jpn.traineddata;$(TesseractBundleDir)\tessdata\jpn_vert.traineddata;$(TesseractBundleDir)\tessdata\osd.traineddata;$(TesseractBundleDir)\tessdata\configs\tsv" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredTesseractFile.Identity)')"
           Text="The Tesseract bundle is incomplete. Missing: %(RequiredTesseractFile.Identity)" />
    <Error Condition="'@(TesseractEngineDll)' == ''"
           Text="The Tesseract bundle is incomplete. No Tesseract 5 engine DLL was found in $(TesseractBundleDir)." />
  </Target>

  <ItemGroup>
    <!-- 通知領域だけにWindows Formsを使い、WPFと同名の型の自動usingは追加しない。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="Assets\CSTViewer.ico" />
    <InternalsVisibleTo Include="CSTViewer.Tests" />
    <InternalsVisibleTo Include="CSTViewer.LoadingBenchmark" />
  </ItemGroup>

</Project>

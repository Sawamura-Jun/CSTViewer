<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 常駐先への転送をWPFの初期化より前に実行する。 -->
    <StartupObject>CSTViewer.Program</StartupObject>
    <!-- exeに埋め込むアイコンは、複数サイズと透過情報を持つICO形式で指定する。 -->
    <ApplicationIcon>Assets\CSTViewer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.7" />
  </ItemGroup>

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- 通知領域だけにWindows Formsを使い、WPFと同名の型の自動usingは追加しない。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="Assets\CSTViewer.ico" />
    <InternalsVisibleTo Include="CSTViewer.Tests" />
    <InternalsVisibleTo Include="CSTViewer.LoadingBenchmark" />
  </ItemGroup>

</Project>

<Window x:Class="CSTViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSTViewer"
        mc:Ignorable="d"
        Title="{x:Static local:ViewerSettings.ApplicationTitle}"
        Width="{x:Static local:ViewerSettings.WindowWidth}"
        Height="{x:Static local:ViewerSettings.WindowHeight}"
        MinWidth="{x:Static local:ViewerSettings.MinimumWindowWidth}"
        MinHeight="{x:Static local:ViewerSettings.MinimumWindowHeight}"
        Background="#202020" FontFamily="Segoe UI, Yu Gothic UI"
        FontSize="{x:Static local:ViewerSettings.UiFontSize}"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Fluentテーマの形状と状態表示を保ち、ホバー時の背景だけを少し明るくする。 -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                         Color="{x:Static local:ViewerSettings.ToolbarButtonHoverBackground}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver"
                         Color="{x:Static local:ViewerSettings.ToolbarButtonHoverBackground}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"
                         Color="{x:Static local:ViewerSettings.ToolbarCheckedButtonHoverBackground}" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- タイトルバー下の既存の余白に線を重ね、レイアウトの高さは変えない。 -->
        <Border x:Name="TitleBarToolbarSeparator" VerticalAlignment="Top" Margin="-12,-12,-12,0"
                Height="{x:Static local:ViewerSettings.TitleBarSeparatorHeight}"
                Background="#383838"
                SnapsToDevicePixels="True" IsHitTestVisible="False" />
        <!-- コントロールへ文字サイズを直接指定し、Fluentテーマの既定スタイルを維持する。 -->
        <!-- 同期モードで幅が半分になっても、操作と保存先を折り返して表示する。 -->
        <WrapPanel x:Name="MainToolbar" Margin="{x:Static local:ViewerSettings.MainToolbarMargin}">
            <Button x:Name="SaveImageButton" Content="Save" IsEnabled="False"
                    MinWidth="0"
                    Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    Click="SaveImageButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                             Content="Copy the entire open file to the desktop with its original filename. Confirm before overwriting an existing file." />
                </Button.ToolTip>
            </Button>
            <Button x:Name="OpenImageButton" Content="Open..."
                    MinWidth="0"
                    Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    Click="OpenImageButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}" Content="Select an image file to open" />
                </Button.ToolTip>
            </Button>
            <Button x:Name="NewWindowButton" Content="New" Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    MinWidth="0"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    Click="NewWindowButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}" Content="New window (Ctrl+Shift+N)" />
                </Button.ToolTip>
            </Button>
            <ToggleButton x:Name="SpreadLayoutButton" Content="Sync(S)" Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                          MinWidth="0"
                          FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                          Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                          Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                          Click="SpreadLayoutButton_Click">
                <ToggleButton.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                             Content="Arrange two windows on the same monitor side by side and sync them. Press again to turn sync off (S)." />
                </ToggleButton.ToolTip>
            </ToggleButton>
            <Button x:Name="DiffImageButton" Content="Diff(D)" IsEnabled="False"
                    MinWidth="0" Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    Click="DiffImageButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                             Content="Compare all pages using this window as the new image and the nearest other window as the old image. Additions are red; deletions are blue (D)." />
                </Button.ToolTip>
            </Button>
            <Button x:Name="FitImageButton" Content="Fit(F)"
                    MinWidth="0"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}" IsEnabled="False"
                    Click="FitImageButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}" Content="Fit the entire image. When already fitted, trim window margins while keeping the zoom level (F)." />
                </Button.ToolTip>
            </Button>
            <Button x:Name="PreviousPageButton" Content="PrevPage" Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    MinWidth="0"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    IsEnabled="False" Click="PreviousPageButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}" Content="Previous page (Page Up)" />
                </Button.ToolTip>
            </Button>
            <Button x:Name="NextPageButton" Content="NextPage" Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    MinWidth="0"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    IsEnabled="False" Click="NextPageButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}" Content="Next page (Page Down)" />
                </Button.ToolTip>
            </Button>
            <Button x:Name="PreviousFileButton" Content="PrevFile(B)" Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    MinWidth="0"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    IsEnabled="False" Click="PreviousFileButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}" Content="Previous image file in the same folder (B)" />
                </Button.ToolTip>
            </Button>
            <Button x:Name="NextFileButton" Content="NextFile(N)" Margin="{x:Static local:ViewerSettings.ToolbarButtonMargin}"
                    MinWidth="0"
                    FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                    Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                    Padding="{x:Static local:ViewerSettings.ToolbarButtonPadding}"
                    IsEnabled="False" Click="NextFileButton_Click">
                <Button.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}" Content="Next image file in the same folder (N)" />
                </Button.ToolTip>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Label x:Name="CropSaveDestinationLabel" Content="Save to"
                       FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                       Target="{Binding ElementName=CropSavePathTextBox}" VerticalAlignment="Center" Padding="0"
                       Margin="0,0,8,0" />
                <TextBox x:Name="CropSavePathTextBox"
                         Width="{x:Static local:ViewerSettings.CropSaveTextMinimumWidth}"
                         FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                         MinWidth="{x:Static local:ViewerSettings.CropSaveTextMinimumWidth}"
                         Height="{x:Static local:ViewerSettings.ToolbarButtonHeight}" MinHeight="0"
                         Padding="{x:Static local:ViewerSettings.ToolbarTextBoxPadding}"
                         AutomationProperties.Name="Save location for crops and diffs">
                    <TextBox.ToolTip>
                        <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                                 Content="End a folder path with \. A filename alone saves to the source folder. Leave blank to name crops after the source image with a timestamp, and diffs after the new image with _dif.tif." />
                    </TextBox.ToolTip>
                </TextBox>
            </StackPanel>
        </WrapPanel>
        <Border x:Name="ImageViewportBorder" Grid.Row="1" CornerRadius="8" BorderBrush="#383838" BorderThickness="1"
                Background="#141414" PreviewMouseDown="ImageViewportBorder_PreviewMouseDown">
            <Grid>
                <Canvas x:Name="ImageViewportCanvas" Background="Transparent" ClipToBounds="True"
                        Focusable="True" SizeChanged="ImageViewportCanvas_SizeChanged"
                        MouseWheel="ImageViewportCanvas_MouseWheel"
                        MouseLeftButtonDown="ImageViewportCanvas_MouseLeftButtonDown"
                        MouseRightButtonDown="ImageViewportCanvas_MouseRightButtonDown"
                        MouseMove="ImageViewportCanvas_MouseMove"
                        MouseLeftButtonUp="ImageViewportCanvas_MouseLeftButtonUp"
                        MouseRightButtonUp="ImageViewportCanvas_MouseRightButtonUp"
                        LostMouseCapture="ImageViewportCanvas_LostMouseCapture">
                    <Image x:Name="DisplayedImage" Stretch="Fill" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <MatrixTransform x:Name="ImageTransform" />
                        </Image.RenderTransform>
                    </Image>
                    <!-- 全体プレビューの上に、元画像の座標に合わせた高精細領域を重ねる。 -->
                    <Image x:Name="DetailRegionImage" Stretch="Fill" IsHitTestVisible="False"
                           Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <MatrixTransform x:Name="DetailRegionTransform" />
                        </Image.RenderTransform>
                    </Image>
                    <Canvas x:Name="CropSelectionOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                        <Rectangle x:Name="CropRubberBand" Stroke="#60CDFF" Fill="#2060CDFF"
                                   StrokeThickness="{x:Static local:ViewerSettings.CropBorderWidth}"
                                   StrokeDashArray="4,2" />
                    </Canvas>
                </Canvas>
                <StackPanel x:Name="EmptyImageHint" HorizontalAlignment="Center"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="Drag and drop an image"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="TIFF / PNG / JPEG / BMP / GIF" Foreground="#9A9A9A"
                               Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <Border x:Name="DropImageOverlay" Visibility="Collapsed" Margin="4"
                        Background="#D020303F" BorderBrush="#60CDFF" BorderThickness="2"
                        CornerRadius="6" IsHitTestVisible="False">
                    <TextBlock Text="Drop to open the image"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#DD141414">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ImageLoadingText" />
                        <ProgressBar x:Name="ImageLoadingProgress" IsIndeterminate="True"
                                     Height="4" Width="240" Margin="0,18,0,0"
                                     AutomationProperties.Name="Image operation progress" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="2,6,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreloadStatusText" Text="Open an image file" Foreground="#9A9A9A"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <TextBlock.ToolTip>
                    <ToolTip FontSize="{x:Static local:ViewerSettings.UiFontSize}"
                             Content="{Binding PlacementTarget.Text, RelativeSource={RelativeSource Self}}" />
                </TextBlock.ToolTip>
            </TextBlock>
            <ProgressBar x:Name="DiffProgressBar" Grid.Column="1" Visibility="Collapsed"
                         Minimum="0" Maximum="100" Height="8" Margin="12,0,0,0" VerticalAlignment="Center"
                         Width="{x:Static local:ViewerSettings.DiffProgressBarWidth}"
                         AutomationProperties.Name="Diff TIFF creation progress" />
            <TextBlock x:Name="ZoomStatusText" Grid.Column="2" Text="—" Margin="12,0,0,0"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="CSTViewer.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CSTViewer"
        Width="{x:Static local:OcrSearchSettings.ResultWindowWidth}"
        Height="{x:Static local:OcrSearchSettings.ResultWindowHeight}"
        MinWidth="{x:Static local:OcrSearchSettings.ResultWindowMinimumWidth}"
        MinHeight="{x:Static local:OcrSearchSettings.ResultWindowMinimumHeight}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#202020" Foreground="#E6E6E6" FontFamily="Segoe UI, Yu Gothic UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="OcrResultTextBox" AutomationProperties.Name="OCR results by page"
                 Padding="10" FontSize="{x:Static local:OcrSearchSettings.ResultTextFontSize}"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="LineArtRemovalImageButton" DockPanel.Dock="Left" Padding="12,5"
                    Content="{x:Static local:OcrSearchSettings.LineArtRemovalButtonText}"
                    ToolTip="Save the TIFF used for OCR after line art removal"
                    Click="LineArtRemovalImageButton_Click" />
            <TextBlock x:Name="LineArtRemovalSaveStatus" Margin="10,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
